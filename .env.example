# ============================================================================
# GUICHET UNIQUE FNPSS — VARIABLES D'ENVIRONNEMENT (.env.example)
# Aucun secret reel ne doit etre commite dans Git (voir CONTRIBUTING.md)
# ============================================================================

# 1. Application & Portail Public
NODE_ENV=development
PORT=3000
PUBLIC_VERIFY_BASE_URL=https://guichet.fnpss.cd/verifier

# 2. Base de donnees PostgreSQL Souveraine (OPS-02, OPS-03)
POSTGRES_USER=fnpss_admin
POSTGRES_PASSWORD=fnpss_dev_secret_change_me
POSTGRES_DB=fnpss_guichet
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fnpss_admin:fnpss_dev_secret_change_me@localhost:5432/fnpss_guichet

# 3. Stockage Objet Chiffre Off-Chain AES-256-GCM (OPS-05)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=fnpss-documents-scelles
STORAGE_ACCESS_KEY=fnpss_storage_admin
STORAGE_SECRET_KEY=fnpss_storage_secret_change_me
DOCUMENT_ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. Authentification Hybride Web2 / Web3Auth (REQ-01, REQ-02, BLK-02, BLK-03)
JWT_SECRET=replace_with_64_char_random_secret_in_production
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
WEB3AUTH_CLIENT_ID=your_web3auth_project_client_id
WEB3AUTH_NETWORK=sapphire_devnet

# 5. Blockchain Layer 2 — Polygon Amoy Testnet / Polygon PoS Mainnet (BLK-01, BLK-09, BLK-11, BLK-12)
BLOCKCHAIN_NETWORK=polygon-amoy
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
FNPSS_REGISTRY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
RELAYER_MAX_DAILY_TX=500

# 6. Notifications Email Transactionnelles (NOT-01)
SMTP_HOST=smtp.fnpss.cd
SMTP_PORT=587
SMTP_FROM=guichet-unique@fnpss.cd
